<?xml version="1.0" encoding="utf-8"?>
<!--
  The WDK and SDK as NuGet packages, pinned to the same version the driver is
  developed against locally (10.0.28000.2526).

  This is how the driver gets built in CI. It is not used by a local build: the
  imports in Directory.Build.props are guarded on the package directory
  existing, so an ordinary developer build keeps using the installed WDK.

  Taking the toolchain from NuGet rather than from the runner image matters for
  three reasons. The newest SDK installed on any GitHub runner image is
  10.0.26100.0, never 10.0.28000.0. The windows-2025 image has the WDK Visual
  Studio extension but no WDK content at all - no km headers, no stampinf, no
  Inf2Cat - so there is nothing to build against there. And Microsoft has asked
  GitHub to remove the in-image WDK entirely in favour of exactly these
  packages, so depending on it is a slow-motion breakage.

  This is also what microsoft/Windows-driver-samples does in its own CI.
-->
<packages>
  <package id="Microsoft.Windows.SDK.CPP"       version="10.0.28000.2526" targetFramework="native" />
  <package id="Microsoft.Windows.SDK.CPP.x64"   version="10.0.28000.2526" targetFramework="native" />
  <package id="Microsoft.Windows.SDK.CPP.arm64" version="10.0.28000.2526" targetFramework="native" />
  <package id="Microsoft.Windows.WDK.x64"       version="10.0.28000.2526" targetFramework="native" />
  <package id="Microsoft.Windows.WDK.arm64"     version="10.0.28000.2526" targetFramework="native" />
</packages>

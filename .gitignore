# Build output. The WDK writes into <project>\<Platform>\<Configuration>\, and
# the ready-to-install package into a 'winvhci' folder beneath that.
winvhci/ARM64/
winvhci/x64/
winvhci/ARM/
winvhci/Win32/
*.obj
*.pdb
*.iobj
*.ipdb
*.tlog/
*.log
*.lastbuildstate
*.recipe
*.FileListAbsolute.txt

# Driver binaries and signing artifacts. Certificates built during a local or
# CI build are per-machine and throwaway, and a PRIVATE key must never be
# committed - hence *.pfx with no exception below, ever.
*.sys
*.cat
*.cer
*.pfx

# The one exception: the PUBLIC half of the release signing certificate. It has
# to be in the repository, because it is what install-winvhci.ps1 trusts and
# what the release workflow checks the signed package against - a release signed
# by anything else would make pnputil hang on an untrusted publisher. There is
# no secret in a .cer; the private key lives only in repository secrets.
!build/winvhci-test.cer

# Third-party tools, fetched rather than vendored - but keep the note that says
# where to fetch them from.
# (Exclude the directory's CONTENTS, not the directory itself - git will not
# re-include a file whose parent directory is excluded.)
build/tools/*
!build/tools/README.md

# Generated INF (stampinf expands winvhci.inx into winvhci.inf at build time).
winvhci/winvhci.inf

# Visual Studio scratch.
.vs/
*.user
*.suo

# VM images and staged payloads never belong in the repo.
*.qcow2
*.vhdx
*.vdi
*.iso
*.fd

# Python virtualenvs for the controller emulator (installed per machine), and
# tool caches.
bumble-venv/
.venv/
__pycache__/
.mypy_cache/

# NuGet WDK/SDK restored by CI (see packages.config)
packages/

# Staged CI artifacts
out/
artifacts/
